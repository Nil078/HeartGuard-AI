{
  "functions": {
    "api/index.py": {
      "includeFiles": "heart_disease_model.pkl,model_metadata.json,data/**,stitch_screens/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__route=$1"
    },
    {
      "source": "/api",
      "destination": "/api/index?__route="
    }
  ]
}
